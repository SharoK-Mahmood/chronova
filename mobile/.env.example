# Use your PC's LAN IP so a physical phone on the same Wi‑Fi can reach the API.
# Android emulator: http://10.0.2.2:3001/api
# iOS simulator:    http://localhost:3001/api
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# Next.js website (used for Google Sign-In bridge in Expo Go)
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Same Web client ID as NEXT_PUBLIC_GOOGLE_CLIENT_ID / GOOGLE_CLIENT_ID
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
